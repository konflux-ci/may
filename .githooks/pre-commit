#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if ((${#files[@]} == 0)); then
	exit 0
fi

for file in "${files[@]}"; do
	gofmt -w "$file"
done

git add -- "${files[@]}"
